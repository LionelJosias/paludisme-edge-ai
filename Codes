#!/usr/bin/env python3
import argparse,random,shutil
from pathlib import Path
from PIL import Image
EXT={".jpg",".jpeg",".png",".bmp",".webp"}
p=argparse.ArgumentParser(); p.add_argument("--images",required=True); p.add_argument("--labels",required=True); p.add_argument("--output",required=True); p.add_argument("--seed",type=int,default=42); a=p.parse_args()
im={x.stem:x for x in Path(a.images).rglob("*") if x.suffix.lower() in EXT}; la={x.stem:x for x in Path(a.labels).rglob("*.txt")}; pairs=[]
for s in sorted(set(im)&set(la)):
 try: Image.open(im[s]).verify(); pairs.append((im[s],la[s]))
 except: pass
random.Random(a.seed).shuffle(pairs); n=len(pairs); cuts=[int(.70*n),int(.85*n)]; groups={"train":pairs[:cuts[0]],"val":pairs[cuts[0]:cuts[1]],"test":pairs[cuts[1]:]}; out=Path(a.output)
for split,items in groups.items():
 (out/split/'images').mkdir(parents=True,exist_ok=True); (out/split/'labels').mkdir(parents=True,exist_ok=True)
 for x,y in items: shutil.copy2(x,out/split/'images'/x.name); shutil.copy2(y,out/split/'labels'/f'{x.stem}.txt')
(out/'data.yaml').write_text(f'path: {out.resolve()}\ntrain: train/images\nval: val/images\ntest: test/images\nnc: 2\nnames: [cell, parasite]\n')
print({k:len(v) for k,v in groups.items()})


