#!/usr/bin/env python3
import argparse
from pathlib import Path
from PIL import Image
EXT={".jpg",".jpeg",".png",".bmp",".webp"}
p=argparse.ArgumentParser(); p.add_argument("--images",required=True); p.add_argument("--labels",required=True); p.add_argument("--nc",type=int,default=2); a=p.parse_args()
ims={x.stem:x for x in Path(a.images).rglob("*") if x.suffix.lower() in EXT}; labs={x.stem:x for x in Path(a.labels).rglob("*.txt")}
counts=[0]*a.nc; boxes=0; bad=[]
for s,l in labs.items():
 try:
  for n,line in enumerate(l.read_text().splitlines(),1):
   if not line.strip(): continue
   q=line.split(); c=int(q[0]); v=list(map(float,q[1:])); assert len(q)==5 and 0<=c<a.nc and all(0<=x<=1 for x in v)
   counts[c]+=1; boxes+=1
 except Exception as e: bad.append((str(l),str(e)))
print("Images:",len(ims)); print("Labels:",len(labs)); print("Missing labels:",len(set(ims)-set(labs))); print("Orphan labels:",len(set(labs)-set(ims))); print("Boxes:",boxes); print("Classes:",counts); print("Invalid labels:",len(bad))
for s,x in ims.items():
 try: Image.open(x).verify()
 except Exception as e: print("Invalid image:",x,e)


