from pathlib import Path
import os,uuid,cv2,numpy as np
from flask import Flask,render_template,request,send_from_directory
BASE=Path(__file__).resolve().parent; RESULTS=BASE/'results';RESULTS.mkdir(exist_ok=True);MODEL=os.getenv('MODEL_PATH',str(BASE.parent/'models'/'best_float16_320.tflite'))
from importlib.util import spec_from_file_location,module_from_spec
s=spec_from_file_location('inf',BASE.parent/'raspberry_pi'/'03_inference.py');m=module_from_spec(s);s.loader.exec_module(m);IT=m.interpreter(MODEL,4)
app=Flask(__name__)
@app.route('/',methods=['GET','POST'])
def index():
 result=None; error=None
 if request.method=='POST':
  f=request.files.get('image')
  if not f: error='Aucune image.'
  else:
   name=uuid.uuid4().hex+'.jpg'; src=RESULTS/('src_'+name);out=RESULTS/name;f.save(src); img=cv2.imread(str(src));inp=IT.get_input_details()[0];z,_,_,_=m.prep(img,320);z=z.astype(np.float32)[None]/255;IT.set_tensor(inp['index'],z);IT.invoke();od=IT.get_output_details()[0];d=m.decode(m.dq(IT.get_tensor(od['index']),od),.25)
   for x,y,w,h,sc,c in d: cv2.rectangle(img,(int(x-w/2),int(y-h/2)),(int(x+w/2),int(y+h/2)),(0,255,0),1)
   cv2.imwrite(str(out),img);result={'image':name,'detections':len(d)}
 return render_template('index.html',result=result,error=error)
@app.route('/results/<name>')
def result_file(name): return send_from_directory(RESULTS,name)
if __name__=='__main__': app.run(host='0.0.0.0',port=5000)


