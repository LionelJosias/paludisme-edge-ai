#!/usr/bin/env python3
import argparse,time,cv2,numpy as np

def interpreter(path,threads):
 try: from ai_edge_litert.interpreter import Interpreter
 except ImportError: from tflite_runtime.interpreter import Interpreter
 x=Interpreter(model_path=path,num_threads=threads); x.allocate_tensors(); return x

def prep(im,s):
 h,w=im.shape[:2]; r=min(s/w,s/h); nw,nh=round(w*r),round(h*r); z=np.full((s,s,3),114,np.uint8); q=cv2.resize(im,(nw,nh)); dx,dy=(s-nw)//2,(s-nh)//2; z[dy:dy+nh,dx:dx+nw]=q; return cv2.cvtColor(z,cv2.COLOR_BGR2RGB),r,dx,dy

def dq(x,d):
 sc,z=d.get('quantization',(0,0)); return ((x.astype(np.float32)-z)*sc if sc else x.astype(np.float32))

def decode(x,conf):
 x=np.squeeze(x);
 if x.ndim!=2:return np.empty((0,6))
 if x.shape[0]<x.shape[1] and x.shape[0]<=100:x=x.T
 if x.shape[1]<6:return np.empty((0,6))
 c=np.argmax(x[:,4:],1); s=np.max(x[:,4:],1); k=s>=conf; return np.c_[x[k,:4],s[k],c[k]]

def main():
 p=argparse.ArgumentParser(); p.add_argument('--model',required=True); p.add_argument('--image',required=True); p.add_argument('--output',default='result.jpg'); p.add_argument('--imgsz',type=int,default=320); p.add_argument('--threads',type=int,default=4); p.add_argument('--conf',type=float,default=.25); a=p.parse_args()
 im=cv2.imread(a.image); x=interpreter(a.model,a.threads); inp=x.get_input_details()[0]; t=time.perf_counter(); z,r,dx,dy=prep(im,a.imgsz); z=z.astype(np.float32)[None]/255.; pre=(time.perf_counter()-t)*1000
 if inp['dtype']==np.uint8:
  sc,zp=inp.get('quantization',(1/255,0)); z=np.round(z/sc+zp).clip(0,255).astype(np.uint8)
 x.set_tensor(inp['index'],z); t=time.perf_counter(); x.invoke(); inf=(time.perf_counter()-t)*1000; t=time.perf_counter(); d=decode(dq(x.get_tensor(x.get_output_details()[0]['index']),x.get_output_details()[0]),a.conf); post=(time.perf_counter()-t)*1000
 for bx,by,bw,bh,s,c in d:
  x1=int((bx-bw/2-dx)/r);y1=int((by-bh/2-dy)/r);x2=int((bx+bw/2-dx)/r);y2=int((by+bh/2-dy)/r);cv2.rectangle(im,(x1,y1),(x2,y2),(0,255,0),1);cv2.putText(im,f'{int(c)}:{s:.2f}',(x1,max(12,y1-2)),0,.4,(0,255,0),1)
 cv2.imwrite(a.output,im); total=pre+inf+post; print(f'pre={pre:.2f} ms inference={inf:.2f} ms post={post:.2f} ms total={total:.2f} ms FPS={1000/total:.3f} detections={len(d)}')
if __name__=='__main__':main()


